generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum CaseStatus { ACTIVE SUSPENDED CLOSED ARCHIVED }
enum PartyRole { PLAINTIFF DEFENDANT APPLICANT RESPONDENT VICTIM ACCUSED OTHER }
enum MonitoringStatus { SUCCESS PARTIAL SOURCE_UNAVAILABLE ERROR }
model User { id String @id @default(cuid()); email String @unique; name String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; clients Client[]; cases Case[]; alerts Notification[] }
model Client { id String @id @default(cuid()); userId String; name String; email String?; phone String?; notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade); cases Case[] }
model Court { id String @id @default(cuid()); name String; city String?; department String?; createdAt DateTime @default(now()); cases Case[] }
model Case { id String @id @default(cuid()); userId String; clientId String?; courtId String?; caseNumber String; caseType String?; specialty String?; subject String?; status CaseStatus @default(ACTIVE); lastCheckedAt DateTime?; lastProceedingAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade); client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull); court Court? @relation(fields:[courtId],references:[id],onDelete:SetNull); parties CaseParty[]; proceedings Proceeding[]; checks MonitoringCheck[]; notifications Notification[]; tasks Task[]; @@unique([userId,caseNumber]); @@index([caseNumber]) }
model Party { id String @id @default(cuid()); name String; document String?; createdAt DateTime @default(now()); cases CaseParty[] }
model CaseParty { caseId String; partyId String; role PartyRole; createdAt DateTime @default(now()); case Case @relation(fields:[caseId],references:[id],onDelete:Cascade); party Party @relation(fields:[partyId],references:[id],onDelete:Cascade); @@id([caseId,partyId]) }
model Proceeding { id String @id @default(cuid()); caseId String; source String; externalId String?; date DateTime?; type String?; description String; rawReference String?; detectedAt DateTime @default(now()); createdAt DateTime @default(now()); case Case @relation(fields:[caseId],references:[id],onDelete:Cascade); @@index([caseId,date]); @@unique([caseId,source,externalId]) }
model MonitoringCheck { id String @id @default(cuid()); caseId String; source String; status MonitoringStatus; checkedAt DateTime @default(now()); message String?; proceedingsFound Int @default(0); case Case @relation(fields:[caseId],references:[id],onDelete:Cascade); @@index([caseId,checkedAt]) }
model Notification { id String @id @default(cuid()); userId String; caseId String?; title String; message String; readAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); case Case? @relation(fields:[caseId],references:[id],onDelete:SetNull); @@index([userId,createdAt]) }
model Task { id String @id @default(cuid()); caseId String; title String; description String?; dueAt DateTime?; completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; case Case @relation(fields:[caseId],references:[id],onDelete:Cascade); @@index([caseId,dueAt]) }
